# Copy this file to `.env` (which is gitignored) and set your keys locally.
# Never commit real secret keys into the repository.

# Server-only secrets (used by Nitro server routes)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Client-exposed publishable key (required for client-side Stripe features)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional: used to build return_url for checkout
PUBLIC_BASE_URL=http://localhost:3000

# Optional pricing table id if you use Stripe Pricing Tables
STRIPE_PRICING_TABLE_ID=price_your_pricing_table_id
